{
    "name": "WSL - NVIDIA GPU",
    "dockerComposeFile": [
        "../../compose.yaml",
        "override.yaml"
    ],
    "service": "zc-marine-robotics",
    "workspaceFolder": "/home/${localEnv:USER_NAME:dev}/${localEnv:WS_DIR:zc_marine_robotics_ws}",
    "remoteUser": "${localEnv:USER_NAME:dev}",
    "postStartCommand": "git submodule sync && git submodule update --init",
    "customizations": {
        "vscode": {
            "extensions": [
                "ranch-hand-robotics.rde-pack",
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "xaver.clang-format"
            ],
            "settings": {
                "ros.distro": "lyrical"
            }
        }
    }
}